{
  "name": "paraspell-cli",
  "version": "1.0.0",
  "description": "Scaffold ParaSpell XCM SDK and XCM API starter apps",
  "type": "module",
  "license": "MIT",
  "author": "ParaSpell",
  "bin": {
    "paraspell-cli": "dist/index.js"
  },
  "files": [
    "dist",
    "assets",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paraspell/cli.git"
  },
  "bugs": {
    "url": "https://github.com/paraspell/cli/issues"
  },
  "homepage": "https://github.com/paraspell/cli#readme",
  "keywords": [
    "paraspell",
    "xcm",
    "polkadot",
    "scaffold",
    "create-app"
  ],
  "scripts": {
    "compile": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "lint": "eslint src e2e --max-warnings 0",
    "lint:fix": "eslint src e2e --fix",
    "format": "prettier src e2e --write",
    "format:check": "prettier src e2e --check",
    "test": "vitest run --project unit",
    "test:e2e": "vitest run --project e2e"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@scure/bip39": "^2.2.0",
    "@stricli/core": "^1.3.0",
    "@vue/compiler-sfc": "^3.5.40",
    "prettier": "3.9.6",
    "validate-npm-package-name": "^8.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/validate-npm-package-name": "^4.0.2",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.18.0"
}
